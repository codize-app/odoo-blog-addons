<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="opt_blog_post_share_links_display_whatsapp" inherit_id="website_blog.opt_blog_post_share_links_display">
        <xpath expr="//div[hasclass('o_wblog_social_links')]" position="inside">
            <a t-attf-href="https://api.whatsapp.com/send/?text=Incre%C3%ADble+entrada+en+el+blog.+#{url_encode(blog_post.website_url)}"
               aria-label="WhatsApp"
               title="WhatsApp"
               t-attf-class="o_whatsapp #{classes}">
                <i class="fa fa-whatsapp text-whatsapp" aria-label="WhatsApp" title="WhatsApp"/>
            </a>
        </xpath>
    </template>
</odoo>